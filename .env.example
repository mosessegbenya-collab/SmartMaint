# Public identifiers only. Never place Clerk secret keys or Convex admin keys here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Public URL of the existing selected Convex deployment. Do not create a replacement.
EXPO_PUBLIC_CONVEX_URL=
# Optional explicit synthetic preview in an exported build; never grants live access.
EXPO_PUBLIC_ENABLE_DEMO=false

# SERVER ONLY: configure these on the selected Convex deployment, not in Expo.
# CLERK_JWT_ISSUER_DOMAIN=https://<existing-clerk-frontend-api-host>
# Token audience must include convex; map email and boolean email_verified.
# One-time internal operator bootstrap (remove these two values after verification):
# SMARTMAINT_BOOTSTRAP_CLERK_SUBJECT=<actual-dashboard-verified-clerk-user-id>
# SMARTMAINT_BOOTSTRAP_AUTHORIZATION_REFERENCE=<approved-institutional-reference>
# Never add CLERK_SECRET_KEY, CONVEX_DEPLOY_KEY, passwords or tokens to EXPO_PUBLIC_*.
