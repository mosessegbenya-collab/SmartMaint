{
  "expo": {
    "name": "SmartMaint",
    "slug": "SmartMaint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "smartmaint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#F2F8FF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F8FF",
          "image": "./assets/brand/approved-logo.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0C172A"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartMaint to identify equipment and photograph equipment faults.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SmartMaint to select equipment fault photos.",
          "cameraPermission": "Allow SmartMaint to capture equipment photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SmartMaint to reauthenticate your approved session."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
